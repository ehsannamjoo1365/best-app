# Create a bot with @BotFather and put its token here
BOT_TOKEN=replace_with_bot_token
# Your Telegram numeric user ID; only this user can manage destinations
OWNER_ID=123456789
# IANA timezone used for morning/evening reports
TIMEZONE=Asia/Tehran
MORNING_TIME=09:00
EVENING_TIME=20:00
# Optional: enable AI-written commentary. Never put this key in public chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DATABASE_PATH=data/marketbot.sqlite3
